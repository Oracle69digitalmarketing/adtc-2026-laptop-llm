# ADTC 2026 Gitignore

# Virtual Environment
.venv/
__pycache__/
*.py[cod]
*$py.class

# llama.cpp source (prebuilt binaries are in bin/; source not needed)
tools/

# Models (CRITICAL: DO NOT COMMIT GGUF — 2.48 GB exceeds GitHub 100 MB limit)
models/
*.gguf

# Build artifacts
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
tmp/
.pytest_cache/
.ruff_cache/
.uv-cache/

# Credentials and sensitive info
.env
.secrets
gemini-credentials.json
.gemini/

# Generated audit artifacts (created by profiler, not committed)
audit.json
verdict.json

# Runtime
profiler-run.log
